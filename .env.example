# App Configuration
NEXT_PUBLIC_APP_NAME=BizBoost Pro
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Cloudflare D1 or SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth & Business Profile API (Required for Email Ownership Verification)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Places API Key (Required for Worldwide Live Google Maps Ratings, Reviews & Official Phone Match)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# QR Code Settings
QR_LOGO_URL=https://your-domain.com/logo.png
