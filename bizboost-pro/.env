# BizBoost Pro Environment Configuration

# App
NEXT_PUBLIC_APP_NAME="BizBoost Pro"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js
NEXTAUTH_SECRET="bizboost-pro-super-secret-key-change-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# Database
# Local development: SQLite (works out of the box)
DATABASE_URL="file:./dev.db"
# Production (Vercel + Supabase / Neon):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"

# Google Gemini AI API Key (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
